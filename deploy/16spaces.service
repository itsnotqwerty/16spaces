[Unit]
Description=16spaces Fresh app
After=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=PORT=__PORT__
EnvironmentFile=-__ENV_FILE__
ExecStart=__DENO_BIN__ run -A dev.ts
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target